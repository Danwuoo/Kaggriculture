{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kaggriculture-dual-topology-seed-registry-v1",
  "type": "object",
  "required": ["schema_version", "engine", "technical", "formal_tiers", "formal_fresh_seeds_executed"],
  "properties": {
    "schema_version": {"const": 1},
    "engine": {
      "type": "object",
      "required": ["commit", "python_blob", "configuration_blob"],
      "properties": {
        "commit": {"const": "bded87b0d7879078c726a93a4884d044f79c4eed"},
        "python_blob": {"const": "4b78842d0f2d4abf6e318a8248b6306454f5c714"},
        "configuration_blob": {"const": "0fcdf2c14c47d3bdc821c02e26263956cf0fd3d8"}
      },
      "additionalProperties": true
    },
    "technical": {
      "type": "object",
      "required": ["seeds", "purpose"],
      "properties": {
        "seeds": {"const": [811407]},
        "purpose": {"const": "D0-D4 correctness/parity/failure testing only"}
      }
    },
    "formal_tiers": {
      "type": "object",
      "required": ["S1", "S2", "S3", "S4"],
      "properties": {
        "S1": {"$ref": "#/$defs/tier"},
        "S2": {"$ref": "#/$defs/tier"},
        "S3": {"$ref": "#/$defs/tier"},
        "S4": {"$ref": "#/$defs/tier"}
      }
    },
    "formal_fresh_seeds_executed": {"type": "boolean"}
  },
  "$defs": {
    "tier": {
      "type": "object",
      "required": ["seeds", "status"],
      "properties": {
        "seeds": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
        "status": {"enum": ["UNAUTHORIZED", "FROZEN", "RUNNING", "COMPLETE"]}
      }
    }
  }
}
